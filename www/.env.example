# Vite reads this file (www/.env). Copy to www/.env and fill in.
# These are exposed to the browser bundle — only ever put PUBLIC values here.

# Supabase project URL and the new PUBLISHABLE key (Settings → API Keys).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Note: CENTOFLOW_BASE_URL (the Go server URL) is a Rust build-time var and
# belongs in the repo-root .env (../.env), not here.

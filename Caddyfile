# Serves the static Vite build on Railway's injected $PORT.
# Caddy sets the correct application/wasm MIME and compresses responses.
:{$PORT:8080}

root * /srv
encode zstd gzip
# Cross-origin isolation — enables SharedArrayBuffer so gpui's web backend
# can run its multi-threaded dispatcher (background tasks off the main
# thread). Without these the console logs "SharedArrayBuffer not available;
# falling back to single-threaded dispatcher". Mirrors vite.config.js's dev
# headers so dev and prod behave the same.
header {
    Cross-Origin-Opener-Policy "same-origin"
    Cross-Origin-Embedder-Policy "require-corp"
}
# Real files (index.html, login.html, /assets/*) are served directly; anything
# else falls back to the app shell.
try_files {path} /index.html
file_server

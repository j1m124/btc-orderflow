# Networked-feature build secrets. Copy to `.env` and fill in real values.
# `scripts/build-wasm.sh` auto-sources this file — no need to `source .env`
# yourself. Vars are embedded into the WASM bundle at compile time via
# `option_env!`; rebuild after editing.

# Centoflow market-data server. Leave the default for local dev against the
# centoflow-server container.
CENTOFLOW_BASE_URL=http://localhost:8080
